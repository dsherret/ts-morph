{
  "extends": "../../tsconfig.common.json",
  "compilerOptions": {
    // the tsgo client's API is disposable
    "lib": ["es2022", "esnext.disposable"],
    // `@ts-morph/common` resolves to its built declarations rather than to its
    // source. The workspace build orders common first, so they are never stale,
    // and the declarations emitted here have to be stated against the shape the
    // package publishes — pointing at source would bake its paths into them.
    "declaration": false,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": [
    "./src"
  ]
}
