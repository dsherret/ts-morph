{
  "extends": "../../tsconfig.common.json",
  "compilerOptions": {
    "lib": ["es2022", "esnext.disposable"],
    // The sources locate `typescript.wasm` with `import.meta.url`, which the
    // CommonJS module target this used to inherit rejects outright. This is the
    // same pair `tsconfig.rollup.json` sets, so what the type check sees is now
    // what the bundle is actually built with.
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": false,
    // The tsgo client's own declarations import its enums through the package's
    // `imports` map, which only a resolver that reads `imports` can follow. Map
    // the specifiers the way that `imports` map does, for the sake of the build
    // scripts, which read this config through a TypeScript of their own; the
    // rollup config does the same for the JS side.
    "paths": {
      "#enums/*": ["../../submodules/typescript-go/_packages/native-preview/dist/enums/*.enum.d.ts"]
    },
    // NOTE: src/tsgo imports the tsgo client from the submodule, which is outside
    // this rootDir. That is a TS6059 on a real emit; it only passes today because
    // the package is type-checked with --noEmit and shipped through rollup. It
    // must be resolved by consuming the client as a declared dependency.
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": [
    "./src"
  ]
}
