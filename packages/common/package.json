{
  "name": "@ts-morph/common",
  "version": "0.29.0",
  "description": "Common functionality for ts-morph packages.",
  "main": "dist/ts-morph-common.js",
  "author": "David Sherret",
  "license": "MIT",
  "repository": "git+https://github.com/dsherret/ts-morph.git",
  "types": "lib/ts-morph-common.d.ts",
  "scripts": {
    "build": "deno task vendorTsgoTypes && deno task build:declarations && deno task build:node && deno task build:browser",
    "build:node": "rimraf dist && deno task createLibFile && deno task rollup",
    "build:browser": "deno task createLibFile && deno task rollup --environment BUILD:browser",
    "build:deno": "rimraf ../../deno/common && rimraf dist-deno && deno task vendorTsgoTypes && deno task rollup --environment BUILD:deno && deno task build:declarations && deno run -A scripts/buildDeno.ts",
    "build:declarations": "deno run -A scripts/buildDeclarations.ts",
    "vendorTsgoTypes": "deno run -A scripts/vendorTsgoTypes.ts",
    "createLibFile": "deno run -A scripts/createLibFile.ts",
    "test": "deno run -A npm:mocha",
    "test:ci": "deno task test",
    "test:debug": "deno task test --inspect-brk",
    "rollup": "rollup --config"
  },
  "dependencies": {
    "minimatch": "^10.0.1",
    "path-browserify": "^1.0.1",
    "tinyglobby": "^0.2.14"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@types/chai": "^5.2.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.14.1",
    "chai": "^5.2.0",
    "cross-env": "^7.0.3",
    "mocha": "^11.1.0",
    "rimraf": "^6.0.1",
    "rollup": "=4.40.0",
    "tslib": "^2.8.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "browser": {
    "./dist/ts-morph-common.js": "./dist/ts-morph-common.browser.mjs",
    "fs": false,
    "node:fs": false,
    "fs/promises": false,
    "node:fs/promises": false,
    "os": false,
    "node:os": false,
    "fs.realpath": false,
    "mkdirp": false,
    "dir-glob": false,
    "graceful-fs": false,
    "tinyglobby": false,
    "source-map-support": false,
    "glob-parent": false,
    "glob": false,
    "path": false,
    "node:path": false,
    "crypto": false,
    "buffer": false,
    "@microsoft/typescript-etw": false,
    "inspector": false,
    "node:url": false,
    "url": false,
    "node:module": false,
    "node:child_process": false,
    "child_process": false,
    "module": false
  }
}
