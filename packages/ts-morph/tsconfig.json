{
  "extends": "../../tsconfig.common.json",
  "compilerOptions": {
    "lib": ["es2022", "esnext.disposable"],
    // resolve the sibling package from source: its published declarations are a
    // pre-built bundle, so type checking against them would test a stale build
    "paths": {
      "@ts-morph/common": ["../common/src/index.ts"]
    },
    // This config only type-checks; the shipped build is produced by rollup. It
    // therefore sets no `rootDir`/`outDir` and emits nothing, because `paths`
    // resolves @ts-morph/common to ../common/src, which in turn imports the tsgo
    // client out of the submodule — no directory under this package contains
    // every input, so there is no honest emit layout to declare. Consuming the
    // tsgo client as a declared dependency is what would fix that.
    "declaration": false,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "./src",
    // `paths` above type-checks @ts-morph/common from source, so its ambient
    // module declarations have to come along; they are not reachable by import
    "../common/src/types.d.ts"
  ]
}
