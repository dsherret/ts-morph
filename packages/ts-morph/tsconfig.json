{
  "extends": "../../tsconfig.common.json",
  "compilerOptions": {
    "lib": ["es2022", "esnext.disposable"],
    // @ts-morph/common is type-checked from source here (see `paths` below), and
    // it locates `typescript.wasm` with `import.meta.url`, which the CommonJS
    // module target this used to inherit rejects outright. Matching what that
    // package sets is also what its own bundle is built with.
    "module": "esnext",
    "moduleResolution": "bundler",
    // resolve the sibling package from source: its published declarations are a
    // pre-built bundle, so type checking against them would test a stale build
    "paths": {
      "@ts-morph/common": ["../common/src/index.ts"],
      // the tsgo client’s declarations reach its enums through the package’s
      // `imports` map, which this config’s resolution mode cannot follow; see the
      // same mapping in ../common/tsconfig.json
      "#enums/*": ["../../submodules/typescript-go/_packages/native-preview/dist/enums/*.enum.d.ts"]
    },
    // This config only type-checks; the shipped build is produced by rollup. It
    // therefore sets no `rootDir`/`outDir` and emits nothing, because `paths`
    // resolves @ts-morph/common to ../common/src, which in turn imports the tsgo
    // client out of the submodule — no directory under this package contains
    // every input, so there is no honest emit layout to declare. Consuming the
    // tsgo client as a declared dependency is what would fix that.
    "declaration": false,
    "strict": true,
    "noEmit": true
  },
  // the quarantined tests name API that no longer exists — that is what they
  // record — so they are no more type-checkable than they are runnable. They are
  // excluded from the mocha run for the same reason; see that directory’s README.
  "exclude": [
    "./src/tests/removed-capabilities"
  ],
  "include": [
    "./src",
    // `paths` above type-checks @ts-morph/common from source, so its ambient
    // module declarations have to come along; they are not reachable by import
    "../common/src/types.d.ts"
  ]
}
